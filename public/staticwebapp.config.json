{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/rss.xml", "rewrite": "/api/news-rss" },
    { "route": "/feed.json", "rewrite": "/api/news-jsonfeed" },
    { "route": "/sitemap.xml", "rewrite": "/api/news-sitemap" },
    { "route": "/article/*", "rewrite": "/api/article-page" },
    { "route": "/correspondents", "redirect": "/newsroom", "statusCode": 301 },
    { "route": "/correspondents/*", "redirect": "/newsroom", "statusCode": 301 },
    { "route": "/economy", "redirect": "/data/economy", "statusCode": 301 },
    { "route": "/trade", "redirect": "/data/trade", "statusCode": 301 },
    { "route": "/government", "redirect": "/data/government", "statusCode": 301 },
    { "route": "/labour", "redirect": "/data/labour", "statusCode": 301 },
    { "route": "/energy", "redirect": "/data/energy", "statusCode": 301 },
    { "route": "/property", "redirect": "/data/property", "statusCode": 301 },
    { "route": "/environment", "redirect": "/data/environment", "statusCode": 301 },
    { "route": "/maritime", "redirect": "/data/maritime", "statusCode": 301 },
    { "route": "/business", "redirect": "/data/business", "statusCode": 301 },
    {
      "route": "/articles/*",
      "allowedRoles": ["anonymous"],
      "headers": { "Cache-Control": "public, max-age=300" }
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    { "route": "/", "rewrite": "/api/page-shell" },
    { "route": "/data", "rewrite": "/api/page-shell" },
    { "route": "/data/*", "rewrite": "/api/page-shell" },
    { "route": "/indicator/*", "rewrite": "/api/page-shell" },
    { "route": "/newsroom", "rewrite": "/api/page-shell" },
    { "route": "/newsroom/*", "rewrite": "/api/page-shell" },
    { "route": "/follow", "rewrite": "/api/page-shell" },
    { "route": "/weekly", "rewrite": "/api/page-shell" },
    { "route": "/corrections", "rewrite": "/api/page-shell" },
    { "route": "/about/ai", "rewrite": "/api/page-shell" },
    { "route": "/api-docs", "rewrite": "/api/page-shell" },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.json", "*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.xml", "*.txt", "/articles/*", "/api/*", "/.auth/*"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://stportabalticabpmff5so.blob.core.windows.net; img-src 'self' data:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
  }
}
