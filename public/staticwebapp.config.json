{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/rss.xml", "rewrite": "/api/news-rss" },
    { "route": "/sitemap.xml", "rewrite": "/api/news-sitemap" },
    { "route": "/article/*", "rewrite": "/api/article-page" },
    {
      "route": "/articles/*",
      "allowedRoles": ["anonymous"],
      "headers": { "Cache-Control": "public, max-age=300" }
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.json", "*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico", "*.xml", "*.txt", "/articles/*", "/api/*", "/.auth/*"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://stportabalticabpmff5so.blob.core.windows.net; img-src 'self' data:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
  }
}
