# ──────────────────────────────────────────────────────────────────────
# portaBaltica Environment Variables
#
# Copy to .env for local development.
# In production, API env vars are set via Azure SWA App Settings.
# ──────────────────────────────────────────────────────────────────────

# ── Application Insights (optional) ──
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Newsroom ──
# Where the frontend reads finished article JSON from. Public, read-only, and
# never carries a credential: articles are generated on a timer by a Function
# that holds the managed identity, and the browser only ever reads the output.
# Defaults to same-origin /articles, which the SWA maps onto the public blob
# container. Point it at a local folder to develop against fixtures.
VITE_ARTICLES_BASE_URL=/articles

# Enable only after the public alias receives mail, branded replies are tested,
# and an owner is monitoring enquiries. This is public build-time configuration.
VITE_BRIEFING_ENQUIRIES_OPEN=false

# Research reuses registered feeds already fetched by the collection stage.
# These optional ceilings bound prompt size. No search API key is used.
NEWSROOM_RESEARCH_MAX_ITEMS=5
NEWSROOM_RESEARCH_MAX_PER_SOURCE=2
NEWSROOM_RESEARCH_MIN_RELEVANCE=2
NEWSROOM_RESEARCH_MAX_SUMMARY_CHARS=800
NEWSROOM_RESEARCH_MAX_AGE_DAYS=120

# Read by the RSS and sitemap Functions (api/news-rss, api/news-sitemap).
SITE_URL=https://portabaltica.naurolabs.com
ARTICLES_BASE_URL=https://portabaltica.naurolabs.com/articles

# Traffic counts for the status panel, published hourly by the visit-stats
# workflow. Public and read-only, like the article JSON above: the Static Web
# App is Free tier and holds no identity, so anything it reads must need no
# credential. Counts requests, not visitors.
VISIT_STATS_URL=https://stportabalticabpmff5so.blob.core.windows.net/stats/visits.json
